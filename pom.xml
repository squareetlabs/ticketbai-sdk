<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.squareetlabs</groupId>
  <artifactId>ticketbai</artifactId>
  <packaging>jar</packaging>
  <version>2.0.0-SNAPSHOT</version>
  <name>ticketbai</name>
  <description>Java package for TicketBAI electronic invoicing (Araba, Bizkaia and Gipuzkoa)</description>
  <url>https://github.com/squareetlabs/ticketbai-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/squareetlabs/ticketbai-sdk/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Alberto Rial Barreiro</name>
      <organization>SquareetLabs</organization>
      <organizationUrl>https://www.squareet.com</organizationUrl>
    </developer>
    <developer>
      <name>Jacobo Cantorna Cigarran</name>
      <organization>SquareetLabs</organization>
      <organizationUrl>https://www.squareet.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/squareetlabs/ticketbai-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/squareetlabs/ticketbai-sdk.git</developerConnection>
    <url>https://github.com/squareetlabs/ticketbai-sdk</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <!-- La misma versión que com.squareetlabs:verifactu 2.x, para que convivan en la misma aplicación.
         DSS 6 usa Jakarta (jakarta.xml.bind); la línea javax (DSS 5.11.1) está en la rama 1.x. -->
    <dss.version>6.5.1</dss.version>
    <!-- DSS 6 trae JAXB 3.0; se alinea con la versión de com.squareetlabs:verifactu 2.x. -->
    <jaxb-api.version>4.0.5</jaxb-api.version>
    <jaxb-runtime.version>4.0.9</jaxb-runtime.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>jakarta.xml.bind</groupId>
        <artifactId>jakarta.xml.bind-api</artifactId>
        <version>${jaxb-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.jaxb</groupId>
        <artifactId>jaxb-runtime</artifactId>
        <version>${jaxb-runtime.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- EU DSS: firma XAdES-EPES -->
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-xades</artifactId>
      <version>${dss.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-token</artifactId>
      <version>${dss.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.europa.ec.joinup.sd-dss</groupId>
      <artifactId>dss-utils-apache-commons</artifactId>
      <version>${dss.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
